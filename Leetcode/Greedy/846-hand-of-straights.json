                    "    def isNStraightHand(self, hand: List[int], groupSize: int) -> bool:",
                    "        if len(hand) % groupSize != 0:",
                    "            return False",
                    "",
                    "        count = Counter(hand)",
                    "        for num in hand:",
                    "            start = num",
                    "            while count[start - 1]:",
                    "                start -= 1",
                    "            while start <= num:",
                    "                while count[start]:",
                    "                    for i in range(start, start + groupSize):",
                    "                        if not count[i]:",
                    "                            return False",
                    "                        count[i] -= 1",
                    "                start += 1",
                    "        return True"
