                    "",
                    "Loop from n minus two down to zero, assign to i.",
                    "Get minimum of n and i plus nums at i plus one, assign to end.",
                    "Loop from i plus one to end exclusive, assign to j.",
                    "If dp at j is True.",
                    "Set dp at i to True.",
                    "Break from loop.",
                    "Return dp at zero."
