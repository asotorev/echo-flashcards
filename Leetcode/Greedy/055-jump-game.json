                    "    const dp = new Array(n).fill(false);",
                    "    dp[n - 1] = true;",
                    "",
                    "    for (let i = n - 2; i >= 0; i--) {",
                    "        const end = Math.min(n, i + nums[i] + 1);",
                    "        for (let j = i + 1; j < end; j++) {",
                    "            if (dp[j]) {",
                    "                dp[i] = true;",
                    "                break;",
