                  "num=1 → 1 in seen? No → seen={1}",
                  "num=2 → 2 in seen? No → seen={1,2}",
                  "num=3 → 3 in seen? No → seen={1,2,3}",
                  "num=1 → 1 in seen? YES → return True immediately"
                ]
              },
              "mentalModel": {
                "keyInsight": "Check BEFORE adding — if already seen, it's a duplicate",
                "whyItWorks": "Set gives O(1) lookup. We return at first duplicate, so best case is O(1) if duplicate is at start.",
                "earlyReturn": "This version returns immediately when duplicate found — doesn't process rest of array."
              },
              "commonMistakes": [
