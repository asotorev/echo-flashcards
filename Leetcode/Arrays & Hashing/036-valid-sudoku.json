                    "            if board[row][c] == '.' { continue }",
                    "            if seen[board[row][c]] { return false }",
                    "            seen[board[row][c]] = true",
                    "        }",
                    "    }",
                    "    for col := 0; col < 9; col++ {",
                    "        seen := make(map[byte]bool)",
                    "        for r := 0; r < 9; r++ {",
                    "            if board[r][col] == '.' { continue }",
                    "            if seen[board[r][col]] { return false }",
                    "            seen[board[r][col]] = true",
