                    "func (s *Solution) Decode(encoded string) []string {",
                    "    if encoded == \"\" {",
                    "        return []string{}",
                    "    }",
                    "    parts := strings.SplitN(encoded, \"#\", 2)",
                    "    sizes := strings.Split(parts[0], \",\")",
                    "    var res []string",
                    "    i := 0",
                    "    for _, sz := range sizes {",
                    "        length, _ := strconv.Atoi(sz)",
                    "        res = append(res, parts[1][i:i+length])",
                    "        i += length",
                    "    }",
                    "    return res",
                    "}"
