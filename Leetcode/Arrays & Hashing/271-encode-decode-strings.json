                    "        if (encoded === '') return [];",
                    "        const idx = encoded.indexOf('#');",
                    "        const sizes = encoded.slice(0, idx).split(',');",
                    "        const data = encoded.slice(idx + 1);",
                    "        const res = [];",
                    "        let i = 0;",
                    "        for (const sz of sizes) {",
                    "            const length = parseInt(sz);",
