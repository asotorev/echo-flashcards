                  "num=3 → count={1:3, 2:2, 3:1}",
                  "",
                  "=== STEP 2: Create frequency buckets ===",
                  "freq = [[], [], [], [], [], [], []] (length = n+1 = 7)",
                  "       idx: 0   1   2   3   4   5   6",
                  "Put numbers into buckets by their frequency:",
                  "1 has count 3 → freq[3].append(1) → freq[3]=[1]",
                  "2 has count 2 → freq[2].append(2) → freq[2]=[2]",
                  "3 has count 1 → freq[1].append(3) → freq[1]=[3]",
                  "freq = [[], [3], [2], [1], [], [], []]",
                  "",
                  "=== STEP 3: Collect k elements from highest frequency ===",
                  "res = []",
                  "i=6: freq[6]=[] → skip",
                  "i=5: freq[5]=[] → skip",
                  "i=4: freq[4]=[] → skip",
                  "i=3: freq[3]=[1] → res.append(1) → res=[1]",
                  "i=2: freq[2]=[2] → res.append(2) → res=[1,2] → len(res)==k → return [1,2]"
